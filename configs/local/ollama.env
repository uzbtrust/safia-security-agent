# Ollama server settings for the LOCAL machine (MacBook Air M4, 16 GB unified RAM).
# These values are part of the experiment config: changing one can change results,
# so record any change in docs/HARDWARE.md and in the run's result.json.

# Loopback only. The agent never needs a network-reachable LLM server.
OLLAMA_HOST=127.0.0.1:11434

# The product path is fully local: no `:cloud` models, no web search.
OLLAMA_NO_CLOUD=1

# 16 GB unified memory: one resident model, one slot (the KV cache is allocated per slot).
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Smaller KV cache and faster prefill at long contexts.
OLLAMA_FLASH_ATTENTION=1

# Server-wide default context window. Ollama's own VRAM-based default on this machine is 4096.
OLLAMA_CONTEXT_LENGTH=8192

# Keep the model loaded between the calls of one eval run, unload soon after.
OLLAMA_KEEP_ALIVE=10m
